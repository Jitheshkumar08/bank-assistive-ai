// Foundation schema for the Multimodal Assistive AI System.
//
// Three models only. Message, Workflow and UserWorkflowSession are
// deliberately deferred: guessing their shape now would mean migrating
// twice.
//
// Vocabulary note: `Session` here is the APPLICATION session -- who is
// using the app, from which branch, and whether that visit is still
// open. It is not the Python engine's in-memory conversation state. The
// two are correlated by id, never merged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// User
// ---------------------------------------------------------

// Who a signed-in account is allowed to be.
//
// Customers are everyone who walks into a branch. ADMIN exists for the
// staff screen that manages branches and their QR codes, and is granted
// only by the boot-time sync of ADMIN_EMAIL -- never by registration.
enum Role {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  fullName String  @map("full_name")
  phone    String?

  // Argon2id hash. Never a plain-text password.
  // Authentication itself lands in the next phase; this column exists
  // now so the auth phase does not require a schema migration.
  passwordHash String @map("password_hash")

  preferredLanguage String  @default("en") @map("preferred_language")
  isActive          Boolean @default(true) @map("is_active")
  role              Role    @default(CUSTOMER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

// ---------------------------------------------------------
// Branch
//
// `code` is the value carried in a QR payload as branch_id
// (for example "BR001"). It is the stable public identifier and the
// whole of the scanned context; `id` stays internal.
// ---------------------------------------------------------

model Branch {
  id String @id @default(uuid()) @db.Uuid

  code    String  @unique
  name    String
  city    String?
  address String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("branches")
}

// ---------------------------------------------------------
// Session
//
// One visit: a user, at a branch, from sign-in until they
// explicitly leave. Completing a banking task does NOT end a session
// -- only an explicit exit does. That mirrors the engine's own rule
// that workflow state and session state are independent.
// ---------------------------------------------------------

enum SessionStatus {
  ACTIVE
  ENDED

  @@map("session_status")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  // Enforces "at most one ACTIVE visit per user" in the database
  // rather than in application code.
  //
  // Holds the user's id while the visit is ACTIVE and null once it
  // ends. PostgreSQL lets a unique index hold many nulls but only one
  // of each non-null value, so a second ACTIVE row for the same user
  // cannot be inserted -- even by two requests racing each other.
  //
  // A partial unique index (WHERE status = 'ACTIVE') expresses this
  // more directly, but Prisma cannot describe one in the schema, and a
  // hand-written one shows up as drift on every later migration.
  activeUserId String? @map("active_user_id") @db.Uuid

  status   SessionStatus @default(ACTIVE)
  language String        @default("en")

  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  endedAt        DateTime? @map("ended_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([activeUserId])
  @@index([userId, status])
  @@index([branchId])
  @@map("sessions")
}
