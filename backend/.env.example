# ---------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/your_database?schema=public"

# Port the API listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API.
# The Vite dev server default is http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

NODE_ENV=development

# Signing key for access tokens. Must be at least 32 characters.
# Generate your own with:
#   node -p "require('crypto').randomBytes(48).toString('base64url')"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="1h"

# The staff account for the admin screen at /admin.
#
# Created if missing and re-synchronised on every backend boot: the
# password is reset to this value and the account is given the ADMIN
# role. That is a development convenience -- for real use, remove
# ADMIN_PASSWORD after first boot and change the password in the app.
# Never put these in the frontend environment.
ADMIN_EMAIL="admin@bankassist.local"
ADMIN_PASSWORD="AdminPassword123!"


# --- Python assistant engine (internal service) ---------------------
# The FastAPI wrapper around language_engine. Never exposed to browsers.
AI_ENGINE_URL="http://127.0.0.1:8000"
# Shared secret; must match AI_ENGINE_TOKEN in the Python service.
AI_ENGINE_TOKEN=""
AI_ENGINE_TIMEOUT_MS=60000
MAX_AUDIO_BYTES=10485760


# --- Remembered payments (welcome-screen suggestions) ---------------
# Offers a returning customer their last payment, and a payment they
# usually make around today's date, as spoken and visual choices.
# Turning this off restores the plain welcome screen with no code change.
SUGGESTIONS_ENABLED=true

# Whether seeded DEMONSTRATION payment history may be used to build
# those suggestions.
#
# MUST STAY FALSE outside an explicit demonstration environment. Demo
# rows are not bank records, and with this off no suggestion can be
# built from them. Unset is treated as false, and only the exact word
# "true" enables it.
#
# NODE_ENV=production refuses it outright: setting this to true there
# is logged as an error and demonstration history stays unreadable.
DEMO_HISTORY_ENABLED=false

# Upper bound for an amount a customer may enter on the review screen,
# in minor units (paise). 1000000 = Rs 10,000.
ACTIVITY_MAX_AMOUNT_MINOR=1000000

# --- Personalisation testing dashboard (DEVELOPMENT ONLY) ----------
# An admin-only screen for managing seeded demo payment history and
# previewing what the detectors would suggest on a simulated date.
#
# MUST STAY FALSE OUTSIDE A DEVELOPER MACHINE. It is one of four
# conditions -- the dashboard also needs a non-production NODE_ENV,
# DEMO_HISTORY_ENABLED=true, and an authenticated ADMIN -- and in
# production the module is not registered at all, so the routes do not
# exist whatever this says.
DEMO_DASHBOARD_ENABLED=false
