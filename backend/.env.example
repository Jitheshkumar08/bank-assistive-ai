# ---------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/your_database?schema=public"

# Port the API listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API.
# The Vite dev server default is http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

NODE_ENV=development

# Signing key for access tokens. Must be at least 32 characters.
# Generate your own with:
#   node -p "require('crypto').randomBytes(48).toString('base64url')"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="1h"

# The staff account for the admin screen at /admin.
#
# Created if missing and re-synchronised on every backend boot: the
# password is reset to this value and the account is given the ADMIN
# role. That is a development convenience -- for real use, remove
# ADMIN_PASSWORD after first boot and change the password in the app.
# Never put these in the frontend environment.
ADMIN_EMAIL="admin@bankassist.local"
ADMIN_PASSWORD="AdminPassword123!"


# --- Python assistant engine (internal service) ---------------------
# The FastAPI wrapper around language_engine. Never exposed to browsers.
AI_ENGINE_URL="http://127.0.0.1:8000"
# Shared secret; must match AI_ENGINE_TOKEN in the Python service.
AI_ENGINE_TOKEN=""
AI_ENGINE_TIMEOUT_MS=60000
MAX_AUDIO_BYTES=10485760
