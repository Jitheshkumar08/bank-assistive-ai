# Copy to .env (git-ignored) and fill in. Placeholders only — never commit real values.

NODE_ENV="development"
PORT=3000

# Least-privilege application role (see README "Database setup"). Never use the postgres superuser here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusguide_dev?schema=public"

# Exact origin of the student frontend (CORS + links in emails).
FRONTEND_ORIGIN="http://localhost:5173"

# Session lifetime in hours (default 12; "remember me" sessions last REMEMBER_ME_DAYS).
SESSION_TTL_HOURS=12
REMEMBER_ME_DAYS=30

# Email delivery for verification and password-reset messages:
#   none       - not configured: registration and password reset return 503 instead of pretending to send.
#   smtp       - real delivery; requires SMTP_URL and EMAIL_FROM.
#   dev-outbox - development only: messages are written to ./.dev-outbox (git-ignored). Refused in production.
EMAIL_TRANSPORT="none"
SMTP_URL=""
EMAIL_FROM=""

# Admission imports: extra spreadsheet header aliases, as JSON, until the official column layout is confirmed.
# Fields: nucatReference, studentName, admissionYear, nucatRank, allocatedBranch, admissionStatus, officialEmail.
# ADMISSION_IMPORT_COLUMN_ALIASES='{"nucatReference":["NUCAT Appl No"]}'

# Swagger UI at /api/docs. Leave unset: on in development, off in production unless set to "true".
# SWAGGER_ENABLED="true"
