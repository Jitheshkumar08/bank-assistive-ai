# Copy to .env.local (git-ignored). Values are PUBLIC: they are compiled into the browser bundle.
# Never put passwords, database URLs, SMTP credentials or API keys here — those belong in backend/.env.

# CampusGuide backend API base URL, including the /api prefix. For local development:
#   VITE_API_BASE_URL=http://localhost:3000/api
# The backend's FRONTEND_ORIGIN must equal this app's origin (http://localhost:5173 in development) so CORS and the
# session cookie work. Leave empty to run the UI without a backend ("not connected" states, nothing faked).
VITE_API_BASE_URL=

# Optional: URL or /public path of a campus photograph you are licensed to use.
# Leave empty to use the built-in illustration.
VITE_CAMPUS_IMAGE_URL=
