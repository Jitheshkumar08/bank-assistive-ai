# ==============================================================================
# Language Engine Environment Configuration
#
# Copy this file to .env (which is gitignored) and fill in the values.
# A variable already exported in the shell wins over this file.
#
#   cp .env.example .env      # Windows: copy .env.example .env
# ==============================================================================

# --- LLM API Key (Required) ---
# Groq key used for dialogue understanding, entity extraction and answers.
# The service refuses to start without it. Never commit the real value.
# A key is issued at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Service Security (Optional for local dev, REQUIRED in production) ---
# One shared secret per application domain, sent as the X-Internal-Token
# header. The token a request presents decides which domain serves it, so
# the two must differ.
#
#   AI_ENGINE_TOKEN          Banking backend   (must match backend/.env)
#   AI_ENGINE_COLLEGE_TOKEN  College backend   (must match college-domain/backend/.env)
#
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# If ANY token is set, every request must present a valid one.
# If none is set, authentication is disabled -- allowed only while
# AI_ENGINE_ENV=development and the port is loopback-only.
AI_ENGINE_TOKEN=
AI_ENGINE_COLLEGE_TOKEN=

# development (default) or production. In production the service refuses
# to start unless every domain has its own token of at least 32 characters.
AI_ENGINE_ENV=development

# --- Workflow actions (Optional, Phase 6) ---
# Seconds a backend action (e.g. the College admission-status lookup) stays
# answerable. A later answer is refused (409 action_expired) and the request
# abandoned. Bounded to 5..900; default 120.
# AI_ENGINE_ACTION_TTL_SECONDS=120

# --- Audio Upload Limit (Optional) ---
# Largest recording the /turn/audio endpoint will accept, in bytes.
# Default 10485760 (10 MB), matching the backend's own limit.
MAX_AUDIO_BYTES=10485760

# --- Server Host & Port (Optional) ---
# Where uvicorn listens. 127.0.0.1 keeps this internal service off the
# network; the backend reaches it through AI_ENGINE_URL.
HOST=127.0.0.1
PORT=8000

# --- Console Encoding (Windows) ---
# Python reads this at interpreter startup, before any file is loaded,
# so it only reaches processes the service spawns. The service already
# reconfigures its own streams to UTF-8; this is for the CLI and the
# debugging/ suites, and only takes effect when set in the shell:
#   PowerShell:  $env:PYTHONIOENCODING = "utf-8"
#   bash:        export PYTHONIOENCODING=utf-8
PYTHONIOENCODING=utf-8

# --- ASR Provider Selection (Optional, Phase 3.2B-11) ---
# Which speech-to-text engine serves each language. Defaults keep English on
# Whisper (unchanged) and send Kannada/Hindi to AI4Bharat IndicConformer.
#
#   auto            route per language using ASR_LANGUAGE_PROVIDERS (default)
#   whisper         force the Whisper baseline for every language
#   indicconformer  force IndicConformer (English is not supported by it)
ASR_PROVIDER=auto

# Per-language routing, "lang=provider" pairs. Only languages listed here are
# routed to a non-default provider; anything else falls through to Whisper.
ASR_LANGUAGE_PROVIDERS=en=whisper,kn=indicconformer,hi=indicconformer

# Provider used when the selected one fails. "none" disables fallback, so a
# failure is raised instead of quietly answering with another model.
# Fallback results are always marked fallback_used=true.
ASR_FALLBACK=whisper

# IndicConformer ONNX weights: int8 (≈138 MB/language, default) or fp32 (≈482 MB).
ASR_INDIC_QUANTIZATION=int8

# Extra or replacement IndicConformer models, "lang=hf-repo" pairs.
# ASR_INDIC_MODELS=ta=OpenVoiceOS/ai4bharat-indicconformer-ta-onnx

# Set to 1 to enable the untested languages of the IndicConformer ONNX family
# (as, bn, brx, doi, gu, kok, ks, mai, ml, mni, mr). Only kn and hi have been
# verified on this project's data. Tulu is NOT supported by any provider.
# ASR_INDIC_ENABLE_UNVERIFIED=0

# Whisper size used by the baseline/fallback provider.
ASR_WHISPER_MODEL=small
