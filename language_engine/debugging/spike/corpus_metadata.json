  "utterances_per_language": 30,

  "_schema_notes": {
    "required_fields": [
      "id", "language", "category", "reference_transcript",
      "expected_intent", "expected_entities", "expected_negation",
      "expected_completion", "speaker_id", "recording_file", "notes"
    ],
    "additions_beyond_the_brief_and_why": {
      "expected_routing": "expected_intent alone cannot express the safety assertion that matters most. IntentDetector is a total function (detector.py:24-29) with no abstention, so it returns one of five banking labels for EVERY input, including 'do not cancel'. For a negation, a control command or a question the correct outcome is not an intent at all -- it is 'must not start any workflow'. This field carries that. Values: workflow_start, no_workflow_start, control:pause, control:resume, control:repeat, session_exit, question, completion.",
      "expected_transcript_must_contain": "Exact substrings that must survive ASR verbatim -- digit runs and English banking terms inside code-mixed speech. Checked after numeral folding only; no other normalisation.",
      "must_not_contain": "Literal-meaning traps for names (Kamala->lotus, Asha->hope, Chandra->moon). A name translated into its meaning is a severity-1 failure.",
      "severity": "Carried over from the Phase 3.2B-6 entity_preservation_matrix.json scale. 1 = moves money or misidentifies an account; 2 = derails the conversation, recoverable; 3 = cosmetic.",
      "gloss_en": "Plain-English gloss so a reviewer who does not read Kannada or Devanagari can audit the expectations. Never used by the evaluator.",
      "audio_status": "missing | recorded. The benchmark runner reads this plus the filesystem, so real speech can be added with NO code change -- drop the WAV in and set this to recorded.",
      "duration_seconds": "Filled in after recording. Needed for the real-time-factor calculation in Step 9."
    },
    "identifier_policy": "Every account number, phone number and name in this corpus is SYNTHETIC. 1234567890 and 9876543210 are deliberately obvious placeholders. No real customer data, no secrets.",
    "known_evaluator_limitation": "Where a speaker reads a digit run as words ('ondu eradu muru' / 'ek do teen') rather than as digits, the evaluator's numeral folding will not recover the ASCII run and the case will be reported as a MISS. That is a limitation of the evaluator, not necessarily of the ASR, and the runner labels it 'spoken_digit_words' rather than scoring it as a silent failure. Resolve it by having speakers read identifier digits as digits (see recording_guide.md)."
  },

  "category_plan": {
    "banking_intent": 5,
    "amount": 5,
    "identifier": 3,
    "name": 3,
    "negation": 4,
    "completion": 2,
    "control": 3,
    "question": 2,
    "code_mixed": 3
  },

